# API settings for local development. Copy to `.env`; `pnpm dev` loads it (nest start --env-file .env).
# In production, set these in the real environment instead.

# PostgreSQL from docker-compose.yml (user, password and database are all "flagpole").
# Uses 127.0.0.1 rather than localhost because the container port is bound to IPv4 loopback only.
# If you set POSTGRES_HOST_PORT in the root .env, change 5433 here to match.
DATABASE_URL=postgres://flagpole:flagpole@127.0.0.1:5433/flagpole
