# Docker Compose settings. Copy to `.env` to override; Compose reads it automatically.
# App settings live in each app's own .env.example (e.g. apps/api/.env.example).

# Host port for the PostgreSQL container (default 5433, because 5432 is often taken by a local install).
# If you change it, update the port in DATABASE_URL in apps/api/.env too.
POSTGRES_HOST_PORT=5433
