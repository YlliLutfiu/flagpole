# Store all text files with LF line endings in the repo,
# so Windows (CRLF) and Linux CI (LF) never produce noisy diffs.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
