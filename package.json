{
  "name": "flagpole",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --write .",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "catalog:",
    "prettier": "3.9.10",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1"
  }
}
